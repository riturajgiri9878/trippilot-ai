# ==========================================
# TripPilot AI - Environment Template
# ==========================================

# Application
APP_NAME=TripPilot AI
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///data/trippilot.db

# --------------------------
# Primary LLM
# --------------------------
GEMINI_API_KEY=

# --------------------------
# Local LLM Fallback
# --------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# --------------------------
# Travel APIs
# --------------------------
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

GEOAPIFY_API_KEY=

# --------------------------
# Reliability
# --------------------------
REQUEST_TIMEOUT=10
MAX_RETRIES=2

# --------------------------
# Security
# --------------------------
SECRET_KEY=

DUFFEL_ACCESS_TOKEN=